# ─────────────────────────────────────────────────────────────────────────────
# Momtaz Shahd — environment variables
# Copy to `.env` for local development. In production, set them in your host's
# environment. Never commit real secrets. [required in production] marks the
# variables the live site cannot work without.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────

# [required in production] Public URL of the site, without a trailing slash,
# e.g. https://momtazshahd.ir. Used for canonical links, hreflang, the sitemap,
# Open Graph, JSON-LD and emails. Read at BUILD time: rebuild after changing it.
# Only an https:// URL turns on HSTS and the CSP upgrade-insecure-requests
# directive (production builds); keep http:// until SSL is set up on the server.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public origin read at RUN time, for links that leave the site (payment
# gateway callbacks). Set it when the runtime URL differs from the build-time
# one (e.g. one image deployed to staging and production). Default: NEXT_PUBLIC_SITE_URL.
APP_URL=""

# ── Database ─────────────────────────────────────────────────────────────────

# [required in production] Database connection. The provider is chosen from
# the URL: "file:…" = SQLite (local development, the default when unset),
# "postgresql://…" = PostgreSQL (production). Run `pnpm db:deploy` after deploying.
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/momtaz_shahd?schema=public"

# ── Sign-in (Auth.js) ────────────────────────────────────────────────────────

# [required in production] Secret that signs session cookies. A long random
# string, e.g. the output of `openssl rand -base64 32`. Changing it signs
# everyone out.
AUTH_SECRET=""

# ── Payments ─────────────────────────────────────────────────────────────────

# Online payment gateway: "zarinpal" | "mock" | "idpay" | "" (empty hides
# online payment; cash on delivery and bank transfer still work).
# "mock" is a simulated bank for development and tests — it lets anyone mark
# an order as paid. "idpay" is a stub and stays disabled until implemented.
PAYMENT_GATEWAY="mock"

# Set to "true" only on a staging server that should use the mock gateway in
# production mode. Leave empty on the live site (mock is then refused).
ALLOW_MOCK_PAYMENTS=""

# [required for Zarinpal] Merchant ID (UUID) from your Zarinpal panel.
ZARINPAL_MERCHANT_ID=""

# "true" sends payments to Zarinpal's sandbox (no real money). Set to "false"
# on the live site.
ZARINPAL_SANDBOX="true"

# ── File storage ─────────────────────────────────────────────────────────────

# Folder for private uploads (bank-transfer receipts, served only to the order
# owner and admins). Must be persistent and NOT publicly served. Default: ./storage
UPLOAD_DIR=""

# Where admin-uploaded images (products, categories, dealers) are stored:
# "local" (default) = public/uploads on this server, served at /uploads/...;
# "s3" = S3-compatible object storage (Liara, ArvanCloud…) — currently a stub.
STORAGE_DRIVER="local"

# S3-compatible storage (only when STORAGE_DRIVER="s3").
# Endpoint, e.g. https://storage.iran.liara.space or https://s3.ir-thr-at1.arvanstorage.ir
S3_ENDPOINT=""
# Region name expected by the provider (often "default").
S3_REGION=""
# Bucket that holds the images.
S3_BUCKET=""
# Access key ID and secret for that bucket (secret: keep private).
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Public base URL of the bucket or the CDN in front of it; also allowed in the
# Content-Security-Policy for images. Read at build time.
S3_PUBLIC_URL=""

# ── Text messages (SMS) ──────────────────────────────────────────────────────

# SMS provider: "console" (default: messages are only printed to the server
# log, for development) or "kavenegar". Every attempt is logged in SmsLog.
SMS_PROVIDER="console"

# Kavenegar (when SMS_PROVIDER="kavenegar"): API key from the Kavenegar panel
# (secret) and your dedicated sender line number.
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""

# Mobile numbers (comma-separated, e.g. 09121234567,09351234567) that receive
# an SMS for every new order and every wholesale/dealer request.
ADMIN_NOTIFY_PHONES=""

# ── Email ────────────────────────────────────────────────────────────────────

# Team inbox for contact-form messages, new orders and wholesale/dealer
# requests. Leave SMTP_HOST empty to skip sending (everything is still saved
# and visible in the admin panel).
ADMIN_EMAIL=""
# SMTP server, port (587 = STARTTLS, 465 = TLS), login and password (secret).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Sender address shown on emails. Default: ADMIN_EMAIL.
SMTP_FROM=""

# ── Maps ─────────────────────────────────────────────────────────────────────

# Neshan web map key (https://platform.neshan.org) for the dealer map. Without
# it the map uses Leaflet with OpenStreetMap tiles. Read at build time (it is
# public: Neshan keys are restricted by domain in their panel).
NEXT_PUBLIC_NESHAN_KEY=""

# ── Tests and audits (development only; not used by the running site) ───────

# Port for the Playwright end-to-end server (`pnpm test:e2e`). Default: 3200.
# E2E_PORT="3200"

# Accounts the design audit (`pnpm audit:design`) signs in with to check the
# account and admin pages. Leave unset to audit public pages only.
# AUDIT_USER_PHONE=""
# AUDIT_USER_PASSWORD=""
# AUDIT_ADMIN_PHONE=""
# AUDIT_ADMIN_PASSWORD=""
# Regular expression limiting which paths the design audit visits, e.g. "^/products".
# AUDIT_ONLY=""
