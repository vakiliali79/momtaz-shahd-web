# Copy to .env for local development.

# Local development: SQLite file (this is also the default when unset).
DATABASE_URL="file:./prisma/dev.db"

# Production: PostgreSQL. The provider is picked from the URL scheme.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/momtaz_shahd?schema=public"

# Public base URL of the site (canonical URLs, hreflang, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact-form emails. Leave SMTP_HOST empty to skip sending (messages are
# still saved to the database).
ADMIN_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Auth.js: a long random string (e.g. `openssl rand -base64 32`). Required.
AUTH_SECRET=""

# Online payments: PAYMENT_GATEWAY = mock | zarinpal | idpay (empty hides online payment).
# "mock" is a simulated bank for development; it lets anyone mark an order as
# paid, so it is refused in production unless ALLOW_MOCK_PAYMENTS="true"
# (staging only). "idpay" is a stub and stays disabled until implemented.
PAYMENT_GATEWAY="mock"
ALLOW_MOCK_PAYMENTS=""
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# Public origin used for payment callbacks, read at runtime (e.g. https://momtazshahd.ir).
# Falls back to NEXT_PUBLIC_SITE_URL.
APP_URL=""

# Private uploads (bank-transfer receipts). Default: ./storage
UPLOAD_DIR=""
